from taxonomake.modules.common import (
    config_sample_reads1,
    config_sample_reads2,
    config_truths,
    config_samples_has_coverages
)

if "classify" in config:
    module classify:
        snakefile: "classify/classify.smk"
        config: config

    use rule * from classify

if config_samples_has_coverages(config):
    module coverages:
        snakefile: "coverages/coverages.smk"
        config: config
    
    use rule * from coverages

if "readsim" in config:
    module simulate:
        snakefile: "simulate/simulate.smk"
        config: config
    
    use rule * from simulate

rule all:
    input:
        config_sample_reads1(config),
        config_sample_reads2(config),
        sorted(set(config_truths(config)))
    localrule: True